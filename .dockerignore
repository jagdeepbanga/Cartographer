# Dependencies & build output (rebuilt inside the image)
node_modules
.next
out
build

# Secrets — never copy real env files into an image layer
.env
.env.*
!.env.example

# VCS & local tooling
.git
.gitignore
.claude
.vscode
.idea

# Docs / research not needed at build time.
# NOTE: do NOT blanket-exclude *.md — agent/prompts/*.md must stay in the build
# context so Next can trace them into the standalone output.
Research
README.md

# TS/build caches & logs
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS cruft
.DS_Store

# Docker files themselves
Dockerfile
.dockerignore
docker-compose.yml
