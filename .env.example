# Anthropic
ANTHROPIC_API_KEY=your_api_key_here

# OpenAI
OPENAI_API_KEY=your_api_key_here

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=your_api_key_here

# OpenRouter — one key, any model from https://openrouter.ai/models
# Default is a free, tool-capable model; override to use a paid one.
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_MODEL=minimax/minimax-m2.7:free

# Postgres — run: docker run --name cartographer-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cartographer

# Active product domain — matches a file in /domain/*.config.json
DOMAIN=beauty

# LLM provider: anthropic | openai | google | openrouter
LLM_PROVIDER=google

# Set to true to skip the LLM entirely and use a scripted demo loop (no API key needed)
MOCK_LLM=false

# Number of products shown per category (default: 4)
PRODUCT_LIMIT=4
